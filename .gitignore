# Environment
.env
.env.*
!.env.example

# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# Build output
dist/
build/
.vite/
output/playwright/
.playwright-cli/
.tmp/

# Logs
*.log

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Private hackathon documents
docs/hackathon/*.pdf
*.hwp
*.pdf

# Generated project storage
storage/logs/*
!storage/logs/.gitkeep
storage/reports/*
!storage/reports/.gitkeep

# Local tooling / personal scratch
.claude/
personal/

# GCP 서비스계정 키 (Vertex AI) — 절대 커밋 금지
secrets/
*service-account*.json
*gcp*key*.json

# ── 게임 맵 (maps/) ──
# 커밋하는 것: .tmx(제작 원본) + geometry.json(게임이 읽는 좌표)
# 배경 PNG는 용량이 커서 구글드라이브로 공유, 검수 산출물은 변환기가 언제든 재생성
maps/**/*.png
maps/**/review.csv
maps/**/debug-overlay.html
maps/**/playtest.html
maps/**/*.mp4
maps/**/*.webm
