# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Database — Supabase (팀 공용 클라우드 DB)
# Supabase 대시보드 → Connect → Session pooler URI 복사 후:
#   1) postgresql:// 을 postgresql+asyncpg:// 로 변경
#   2) [YOUR-PASSWORD] 를 실제 비밀번호로 교체
#   3) 끝에 ?ssl=require 추가
# 예: postgresql+asyncpg://postgres.abcdefgh:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=

# 개인정보 암호화 (AES-256-GCM) — ⚠️ 팀 전원 동일한 키 사용 (DM으로 공유)
# 생성: openssl rand -base64 32 / 비우면 개발용 고정키(경고 로그)
AES_KEY=

# Auth — 시연 전 교체
JWT_SECRET=

# Infra — 도커 컴포즈 사용 시 컨테이너 내부 값이 자동 주입되므로 수정 불필요
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=storage
