# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Database — Supabase (팀 공용 클라우드 DB)
# Supabase 대시보드 → Connect → Session pooler URI 복사 후:
#   1) postgresql:// 을 postgresql+asyncpg:// 로 변경
#   2) [YOUR-PASSWORD] 를 실제 비밀번호로 교체
#   3) 끝에 ?ssl=require 추가
# 예: postgresql+asyncpg://postgres.abcdefgh:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=

# 개인정보 암호화 (AES-256-GCM) — ⚠️ 팀 전원 동일한 키 사용 (DM으로 공유)
# 생성: openssl rand -base64 32 / 비우면 개발용 고정키(경고 로그)
AES_KEY=

# Auth — 시연 전 교체
JWT_SECRET=

# 소셜 로그인 (OAuth) — 각 provider 개발자 콘솔에서 앱 등록 후 발급받아 채움(DM 공유, 커밋 금지).
# 비워두면 해당 provider 로그인은 503(미설정)으로 응답 → 키 넣는 순간 활성화.
# 등록 시 redirect URI: {OAUTH_REDIRECT_BASE}/api/auth/oauth/{google|kakao|naver}/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_KAKAO_CLIENT_ID=          # 카카오 REST API 키
OAUTH_KAKAO_CLIENT_SECRET=      # (선택) 카카오 보안 설정 켰을 때만
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
# 콜백 받는 백엔드 공개 주소(배포 시 https 도메인) / 로그인 후 토큰 돌려줄 프론트 주소
OAUTH_REDIRECT_BASE=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ── 배포(HTTPS) — Caddy가 PUBLIC_DOMAIN에 자동 HTTPS(Let's Encrypt) 발급 ──
# 절차: (1) DuckDNS 등 무료 서브도메인을 VM 공인 IP로 지정  (2) GCP 방화벽 tcp:80,443 개방
#       (3) 아래 PUBLIC_DOMAIN + 위 3개(VITE_API_BASE_URL·OAUTH_REDIRECT_BASE·FRONTEND_URL)를
#           모두 https 도메인으로 통일  (4) docker compose up -d --build 재배포
# ⚠️ VITE_API_BASE_URL은 프론트 '빌드 시점'에 baked → 값 바꾸면 web 재빌드 필수(--build).
# 미설정 시 PUBLIC_DOMAIN=localhost(내부 인증서), VITE_API_BASE_URL=http://localhost:8000 로 동작.
PUBLIC_DOMAIN=
VITE_API_BASE_URL=
# 배포 예) PUBLIC_DOMAIN=neunglog.duckdns.org
#         VITE_API_BASE_URL=https://neunglog.duckdns.org
#         OAUTH_REDIRECT_BASE=https://neunglog.duckdns.org
#         FRONTEND_URL=https://neunglog.duckdns.org

# Infra — 도커 컴포즈 사용 시 컨테이너 내부 값이 자동 주입되므로 수정 불필요
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=storage
