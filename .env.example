# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# 비워두면 config.py 기본값(gemini-3.6-flash) 사용 — 보통 지정할 필요 없다.
GEMINI_MODEL=gemini-3.6-flash

# TTS — 우선순위: ELEVENLABS_API_KEY(클론 보이스) > OPENAI_API_KEY > mock(비프음).
# 클론 보이스 생성: ElevenLabs 대시보드 또는 POST /v1/voices/add 로 만든 뒤 voice_id를 아래에.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Database — Supabase (팀 공용 클라우드 DB)
# Supabase 대시보드 → Connect → Session pooler URI 복사 후:
#   1) postgresql:// 을 postgresql+asyncpg:// 로 변경
#   2) [YOUR-PASSWORD] 를 실제 비밀번호로 교체
#   3) 끝에 ?ssl=require 추가
# 예: postgresql+asyncpg://postgres.abcdefgh:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=

# 개인정보 암호화 (AES-256-GCM) — ⚠️ 팀 전원 동일한 키 사용 (DM으로 공유)
# 생성: openssl rand -base64 32 / 비우면 개발용 고정키(경고 로그)
AES_KEY=

# Auth — 시연 전 교체
JWT_SECRET=
# 개발 편의 인증(토큰 없으면 데모 계정 폴백 · X-User-Id 헤더로 사용자 지정). **로컬 개발만 true.**
# 코드 기본값은 False(secure-by-default)라 배포는 이 값을 비워두면(=False) 안전하다.
# ⚠️ 배포에 true면 익명(토큰 없는) 요청이 한 데모 계정에 뒤섞여 유저간 대화가 노출된다(2026-07-22 사고).
ALLOW_DEV_AUTH=true

# 소셜 로그인 (OAuth) — 각 provider 개발자 콘솔에서 앱 등록 후 발급받아 채움(DM 공유, 커밋 금지).
# 비워두면 해당 provider 로그인은 503(미설정)으로 응답 → 키 넣는 순간 활성화.
# 등록 시 redirect URI: {OAUTH_REDIRECT_BASE}/api/auth/oauth/{google|kakao|naver}/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_KAKAO_CLIENT_ID=          # 카카오 REST API 키
OAUTH_KAKAO_CLIENT_SECRET=      # (선택) 카카오 보안 설정 켰을 때만
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
# 콜백 받는 백엔드 공개 주소(배포 시 https 도메인) / 로그인 후 토큰 돌려줄 프론트 주소
OAUTH_REDIRECT_BASE=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# 공공데이터 API (직무 지식 RAG 보강용 — data/knowledge/ 하베스팅 스크립트 전용)
# 고용24(워크넷) 채용정보(wantedApi.do)·직무데이터사전(NCS) — 2026-07-22 포기함.
# 신청서가 단일 양식이고, 채용정보목록/상세는 개인회원 이용 불가(민간 직업소개·정보제공
# 사업자만 — 사업자등록증+직업정보제공사업신고확인증 필요) 확인. harvest-public-job-data.py는
# 코드로만 남겨둠(재도전 시 참고용) — WORK24_API_KEY는 채우지 않음.
WORK24_API_KEY=
# 커리어넷 진로심리검사 — 인증키 승인 완료, /api/career-test 연동 완료(2026-07-20).
CAREERNET_API_KEY=

# 공공데이터포털 인증키 — 맞춤 취업 지원제도 카드(/api/policies/card)용.
# 보조금24 · 복지로(중앙부처/지자체) 3개 API가 같은 키를 쓴다. **Decoding 키**를 넣을 것.
# 활용신청: data.go.kr 로그인 → 각 API '활용신청'(자동승인) → 마이페이지 > 오픈API에서 확인.
# ⚠️ 승인 직후 몇 시간은 403이 날 수 있음(키 전파 지연). 시간 두고 재시도.
# 비우면 카드가 available=false로 내려와 기본 안내 문구가 나갈 뿐, 상담은 정상 동작한다.
DATA_GO_KR_API_KEY=

# 온통청년 청년정책API — 위와 **발급처가 다르다**(youthcenter.go.kr 자체 발급, 키는 UUID).
# 신청: youthcenter.go.kr > 오픈API > 활용신청. 취업 정책 686건을 '일자리>취업' 분류로
# 정확히 받을 수 있어(키워드 추측 불필요) 카드 품질이 가장 좋은 소스다.
# 비우면 이 소스만 빠지고 나머지 제도로 카드는 계속 나온다.
YOUTH_POLICY_API_KEY=

# Infra — 도커 컴포즈 사용 시 컨테이너 내부 값이 자동 주입되므로 수정 불필요
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=storage

# 아바타 (SoulX-FlashHead / Colab) — gradio_app_streaming.py를 share=True로 띄운 공개 URL.
# ⚠️ Colab 세션 새로 띄울 때마다 URL 바뀜 → 갱신 후 백엔드 재시작. 비우면 idle 루프만 재생.
AVATAR_GRADIO_URL=
# Colab SoulX FastAPI POC URL. 설정되면 Gradio URL보다 우선 사용.
AVATAR_FASTAPI_URL=
