        {
          "key": "b",
          "label": "매뉴얼을 꼼꼼히 읽고 원리를 파악한다",
          "dimension_scores": {
            "investigative": 8
          }
        },
        {
          "key": "c",
          "label": "내 나름의 순서를 새로 짜본다",
          "dimension_scores": {
            "artistic": 6,
            "enterprising": 3
