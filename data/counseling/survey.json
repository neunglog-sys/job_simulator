          "key": "b",
          "label": "자료조사를 맡아 근거부터 모은다",
          "dimension_scores": {
            "investigative": 8
          }
        },
        {
          "key": "c",
          "label": "발표 자료나 결과물의 완성도를 맡는다",
          "dimension_scores": {
            "artistic": 8
          }
        },
        {
          "key": "d",
          "label": "다들 무슨 역할을 원하는지 먼저 물어본다",
