{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "npc.job-override.v1",
  "type": "object",
  "required": ["schema_version", "job", "review", "prompt_contract", "kb_stages", "content_variants", "provenance"],
  "properties": {
    "schema_version": {"const": "npc.job-override.v1"},
    "job": {
      "type": "object",
      "required": ["job_id", "job_name", "family_id", "family_name", "module"],
      "properties": {
        "job_id": {"type": "string", "pattern": "^J[0-9]{3}$"},
        "job_name": {"type": "string", "minLength": 1},
        "family_id": {"type": "string", "pattern": "^F[0-9]{2}$"},
        "family_name": {"type": "string", "minLength": 1},
        "module": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "required": ["status", "generated", "human_review_required"]
    },
    "prompt_contract": {
      "type": "object",
      "required": ["npc_visible", "coach_private"],
      "properties": {
        "npc_visible": {
          "type": "object",
          "required": ["work_targets", "npc_roles", "outputs", "forbidden"]
        },
        "coach_private": {
          "type": "object",
          "required": ["success_criteria", "failure_patterns"]
        }
      }
    },
    "kb_stages": {"type": "array", "minItems": 5, "maxItems": 5},
    "content_variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category", "rag_status", "npc_visible", "stages", "missions"],
        "properties": {
          "stages": {"type": "array", "minItems": 5},
          "missions": {"type": "array", "minItems": 5}
        }
      }
    },
    "provenance": {"type": "object", "required": ["excel", "research_sources"]}
  }
}
