{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coach.response.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "request_id",
    "run_id",
    "mission_id",
    "stage_id",
    "coach_message",
    "cards",
    "retry_instruction"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "enum": ["coach.response.v1"]
    },
    "request_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "stage_id": {"type": "string", "minLength": 1},
    "coach_message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    },
    "cards": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/card"
      }
    },
    "retry_instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "quote"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1, "maxLength": 300}
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "card_type",
        "severity",
        "title",
        "summary",
        "details",
        "evidence_refs"
      ],
      "properties": {
        "card_id": {"type": "string", "minLength": 1},
        "card_type": {
          "enum": [
            "safety_stop",
            "error_correction",
            "requirement_check",
            "better_expression",
            "success"
          ]
        },
        "severity": {
          "enum": ["critical", "warning", "info", "success"]
        },
        "title": {"type": "string", "minLength": 1, "maxLength": 40},
        "summary": {"type": "string", "minLength": 1, "maxLength": 90},
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed",
            "expected",
            "why_it_matters",
            "how_to_fix",
            "example"
          ],
          "properties": {
            "observed": {"type": "string", "minLength": 1},
            "expected": {"type": "string", "minLength": 1},
            "why_it_matters": {"type": "string", "minLength": 1},
            "how_to_fix": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {"type": "string", "minLength": 1}
            },
            "example": {"type": "string", "minLength": 1}
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "source_chunk_ids": {
          "type": "array",
          "items": {"type": "string"},
          "default": []
        }
      }
    }
  }
}
